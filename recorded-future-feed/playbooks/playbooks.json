              "@type": "WorkflowStep",
              "name": "Configuration",
              "arguments": {
                "indicator_type": "ip",
                "risk_rule": "",
                "reputation": "Suspicious",
                "tlp": "Amber",
                "confidence": "",
                "expiry": 30,
                "limit": "",
