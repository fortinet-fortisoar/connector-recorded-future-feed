            {
              "@type": "WorkflowStep",
              "name": "Start",
              "arguments": {
                "step_variables": {
                  "input": {
                    "params": []
                  },
                  "_configuration_schema": "[\n  {\"title\": \"Indicator Type\", \"name\": \"indicator_type\", \"type\": \"select\", \"required\": true, \"editable\": true, \"visible\": true, \"options\": [\"ip\", \"domain\", \"url\", \"hash\", \"vulnerability\"], \"value\": \"ip\", \"tooltip\": \"Recorded Future risklist to pull on each scheduled run.\"},\n  {\"title\": \"Risk Rule (Optional)\", \"name\": \"risk_rule\", \"type\": \"text\", \"required\": false, \"editable\": true, \"visible\": true, \"tooltip\": \"Optional risk rule name. Leave blank for the default master risklist.\"},\n  {\"title\": \"Reputation\", \"name\": \"reputation\", \"type\": \"select\", \"required\": true, \"editable\": true, \"visible\": true, \"options\": [\"Good\", \"Suspicious\", \"Malicious\", \"No Reputation Available\", \"TBD\"], \"value\": \"Suspicious\"},\n  {\"title\": \"TLP\", \"name\": \"tlp\", \"type\": \"select\", \"required\": false, \"editable\": true, \"visible\": true, \"options\": [\"Red\", \"Amber\", \"Green\", \"White\"], \"value\": \"Amber\"},\n  {\"title\": \"Confidence (Override)\", \"name\": \"confidence\", \"type\": \"integer\", \"required\": false, \"editable\": true, \"visible\": true, \"value\": 75, \"validation\": {\"minlength\": 0, \"maxlength\": 100}, \"tooltip\": \"If set, overrides the per-indicator score-derived confidence.\"},\n  {\"title\": \"Maximum Age (in days)\", \"name\": \"expiry\", \"type\": \"integer\", \"required\": false, \"editable\": true, \"visible\": true, \"value\": 30},\n  {\"title\": \"Per-Run Limit (Optional)\", \"name\": \"limit\", \"type\": \"integer\", \"required\": false, \"editable\": true, \"visible\": true}\n]"
                }
              },
              "top": "40",
              "left": "40",
              "stepType": "/api/3/workflow_step_types/b348f017-9a94-471f-87f8-ce88b6a7ad62",
              "uuid": "rf110001-0000-4000-a000-000000000000"
